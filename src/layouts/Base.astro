---
import '../styles/global.css';
import { site } from '../config';
import AskBlog from '../components/AskBlog.astro';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	type?: 'website' | 'article';
	narrow?: boolean;
	landing?: boolean;
	noindex?: boolean;
}
const { title, description = site.description, image, type = 'website', narrow = false, landing = false, noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fullTitle = title ? `${title} · ${site.shortName}` : `${site.shortName}: ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = image ? new URL(image, Astro.site) : new URL(`${base}/og.png`, Astro.site);
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<!doctype html>
<html lang={site.language} data-onetag-key={site.ai.key} data-onetag-site={site.ai.site} data-base={base + '/'}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
		<link rel="alternate" type="application/rss+xml" title={site.shortName} href={`${base}/rss.xml`} />
		<link rel="sitemap" href={`${base}/sitemap-index.xml`} />
		<meta property="og:title" content={title || site.shortName} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={og} />
		<meta name="twitter:card" content="summary_large_image" />
		{noindex && <meta name="robots" content="noindex" />}
		<script async src="https://www.googletagmanager.com/gtm.js?id=GTM-WLBP642G"></script>
		<script is:inline>
  			window.dataLayer = window.dataLayer || [];
  			function gtag(){dataLayer.push(arguments);}
  			gtag('js', new Date());
		</script>
		<slot name="head" />
	</head>
	<body>
		<header class="site-header">
			<div class="site-header-row">
				<a class="wordmark" href={`${base}/`}>&lt;{site.shortName}/&gt;</a>
				<nav class="site-nav" aria-label="Main">
					{site.nav.map((item) => (
						<a href={base + item.href} aria-current={isActive(base + item.href) ? 'page' : undefined}>{item.label}</a>
					))}
					<AskBlog />
				</nav>
			</div>
		</header>
		<main class:list={[{ narrow, landing }]}>
			<slot />
		</main>
		<footer class="site-footer">
			<div class="site-footer-row">
				<span>German, Norwegian, Canadian, in that order. Montréal since 2001.</span>
				<nav aria-label="Footer">
					<a href={`${base}/rss.xml`}>RSS</a>
					<a href={`${base}/llms.txt`}>llms.txt</a>
					<a href={site.author.links.github}>GitHub</a>
					<a href={site.author.links.linkedin}>LinkedIn</a>
				</nav>
			</div>
		</footer>
	</body>
</html>
