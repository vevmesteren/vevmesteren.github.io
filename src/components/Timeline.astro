---
const entries = [
	{ mark: '1998', text: 'The web happens to a would-be actor and historian' },
	{ mark: '2000s', text: 'A decade of agencies: McCann, Ogilvy, Phéromone' },
	{ mark: '2014', text: 'Co-founder and CEO, Qi Sports' },
	{ mark: '2018', text: 'BRP Digital Factory' },
	{ mark: '2021', text: 'National Bank of Canada' },
	{ mark: 'NOW', text: 'The agentic economy', now: true },
];
---

<section class="timeline">
	<ol class="timeline-list">
		{entries.map((e, i) => (
			<li class={e.now ? 'now' : i === 0 ? 'first' : ''}>
				<span class="mark">{e.mark}</span>
				<span class="text">{e.text}</span>
			</li>
		))}
	</ol>
</section>

<style>
	.timeline { padding: 24px 0; border-bottom: var(--rule); overflow-x: auto; }
	.timeline-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(6, minmax(150px, 1fr)); gap: 0; min-width: 900px; }
	.timeline-list li { padding: 0 16px 0 12px; border-left: 1px solid var(--ink); }
	.timeline-list li.first { border-left-width: 2px; }
	.timeline-list li.now { border-left: 2px solid var(--accent); }
	.mark { display: block; font: 700 var(--fs-meta)/1 var(--font-mono); }
	.now .mark { color: var(--accent); }
	.text { display: block; font-size: var(--fs-ui); margin-top: 4px; line-height: 1.3; }
</style>
