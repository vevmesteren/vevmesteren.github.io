---
// 12-col post layout: numbered chapter list on left, body in middle, takeaways on right.
interface Props { takeaways?: string[] }
const { takeaways } = Astro.props;
---

<section class="post-layout">
	<nav class="chapters" aria-label="Chapters">
		<details open class="chapters-wrap">
			<summary>Chapters</summary>
			<ol class="chapter-list" id="chapter-list"></ol>
		</details>
	</nav>
	<article class="post-body" data-pagefind-body>
		<div class="prose"><slot /></div>
	</article>
	<aside class="post-aside">
		{takeaways && takeaways.length > 0 && (
			<div class="aside-box">
				<p class="label">Takeaways</p>
				<ul>{takeaways.map((t) => <li>{t}</li>)}</ul>
			</div>
		)}
		<slot name="aside" />
	</aside>
</section>

<style is:global>
	.post-layout { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); padding: 48px 0 80px; }
	.chapters { grid-column: 1 / span 3; }
	.chapters-wrap { position: sticky; top: 24px; }
	.chapters-wrap summary { font: 700 var(--fs-meta)/1 var(--font-mono); text-transform: uppercase; letter-spacing: 0.04em; padding: 12px 0; border-top: var(--rule-heavy); cursor: pointer; }
	.chapters-wrap[open] summary { border-bottom: 1px solid var(--hairline); }
	.chapter-list { list-style: none; margin: 0; padding: 0; font-size: 15px; line-height: 1.3; }
	.chapter-list li { padding: 12px 0; border-bottom: 1px solid var(--hairline); display: flex; gap: 12px; }
	.chapter-list .num { font: 400 var(--fs-meta-sm)/1 var(--font-mono); color: var(--faint); min-width: 20px; }
	.chapter-list li.active .num { color: var(--accent); }
	.chapter-list li.active a { font-weight: 700; }
	.chapter-list a { color: var(--ink); }
	.chapter-list a:hover { color: var(--accent); }
	.post-body { grid-column: 4 / span 6; max-width: 760px; }
	.post-body .prose { max-width: 68ch; }
	.post-aside { grid-column: 10 / span 3; display: flex; flex-direction: column; gap: 24px; padding-top: 4px; }
	.post-aside .aside-box { margin: 0; }
	@media (max-width: 1100px) {
		.post-layout { grid-template-columns: 1fr; }
		.chapters, .post-body, .post-aside { grid-column: auto; }
		.post-aside { order: -1; }
		.chapters-wrap { position: static; }
	}
	@media (max-width: 900px) {
		.chapters-wrap { position: static; }
		.chapters-wrap:not([open]) .chapter-list { display: none; }
	}
</style>

<script>
	// Number h2s inside the body and build the chapter list from them.
	function buildChapters() {
		const body = document.querySelector<HTMLElement>('.post-body .prose');
		const list = document.getElementById('chapter-list');
		if (!body || !list) return;
		const headings = Array.from(body.querySelectorAll<HTMLElement>('h2'));
		headings.forEach((h, i) => {
			const num = String(i + 1).padStart(2, '0');
			if (!h.id) {
				const text = (h.textContent || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
				h.id = text || `chapter-${num}`;
			}
			if (!h.querySelector('.num')) {
				const span = document.createElement('span');
				span.className = 'num';
				span.textContent = num;
				h.prepend(span, ' ');
			}
		});
		list.innerHTML = headings.map((h, i) => {
			const num = String(i + 1).padStart(2, '0');
			const title = h.textContent?.replace(/^\s*\d+\s*/, '').trim() || '';
			return `<li data-id="${h.id}"><span class="num">${num}</span><a href="#${h.id}">${title}</a></li>`;
		}).join('');

		// Active chapter via IntersectionObserver.
		const items = list.querySelectorAll('li');
		const io = new IntersectionObserver((entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) {
					const id = entry.target.id;
					items.forEach((li) => li.classList.toggle('active', (li as HTMLElement).dataset.id === id));
				}
			});
		}, { rootMargin: '0px 0px -60% 0px', threshold: 0 });
		headings.forEach((h) => io.observe(h));
	}
	if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', buildChapters);
	else buildChapters();
</script>
