---
import type { BlogPost, RadarPost } from '../lib/posts';
import { formatDate, readingTime, tagSlug } from '../lib/posts';

interface Props { posts: (BlogPost | RadarPost)[]; kind?: 'blog' | 'radar' }
const { posts, kind = 'blog' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const urlFor = (p: BlogPost | RadarPost) => kind === 'radar' ? `${base}/radar/${p.id}/` : `${base}/blog/${p.id}/`;
---

<ul class="post-list">
	{posts.map((post) => (
		<li>
			<time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
			<div>
				<h3><a href={urlFor(post)}>{post.data.title}</a></h3>
				<p>{post.data.description}</p>
				<div class="tags">
					{post.data.tags.map((t) => <a class="tag" href={`${base}/tags/${tagSlug(t)}/`}>{t}</a>)}
					{kind === 'blog' && <span class="tag">{readingTime((post as BlogPost).body)} min</span>}
				</div>
			</div>
		</li>
	))}
</ul>
