---
// Home panel: the reader says what they work on; the blog picks three posts for them.
---

<reader-fit class="reader-fit" data-ai-ui>
	<h2 class="reader-fit-title">Not sure where to start? Tell me what you care about.</h2>
	<form class="fit-form reader-fit-form">
		<label for="fit-in" class="visually-hidden">Your interest</label>
		<input id="fit-in" type="text" name="about" maxlength="200" placeholder="e.g. how regulators think about agents" required />
		<button type="submit" class="pick">Pick three</button>
	</form>
	<ul class="squares fit-list" hidden></ul>
	<p class="status fit-status"></p>
</reader-fit>

<style>
	.reader-fit { display: flex; flex-wrap: wrap; gap: 24px; align-items: center; justify-content: space-between; padding: 40px 0; border-bottom: var(--rule); }
	.reader-fit-title { margin: 0; flex: 1 1 360px; font-size: 36px; font-weight: 750; font-stretch: 80%; line-height: 1.05; color: var(--ink); }
	.reader-fit-form { flex: 1 1 520px; display: flex; border: 2px solid var(--ink); background: var(--surface); padding: 0; }
	.reader-fit-form input { flex: 1; min-width: 0; border: 0; padding: 14px 16px; height: auto; font-size: 18px; background: transparent; }
	.reader-fit-form input:focus { outline: 0; }
	.reader-fit-form .pick { border: 0; background: var(--ink); color: var(--on-ink); padding: 0 22px; font: 700 16px/1 var(--font-sans); min-height: 52px; cursor: pointer; border-radius: 0; }
	.reader-fit-form .pick:hover { background: var(--accent); }
	.reader-fit-form .pick:disabled { opacity: 0.6; }
	.fit-list { flex-basis: 100%; margin-top: 16px; }
	.status { flex-basis: 100%; }
	.visually-hidden { position: absolute; left: -9999px; }
</style>

<script>
	import { ask, hasKey, errorText } from '../scripts/ai';
	class ReaderFit extends HTMLElement {
		connectedCallback() {
			const form = this.querySelector('form')!, list = this.querySelector<HTMLElement>('.fit-list')!, status = this.querySelector<HTMLElement>('.fit-status')!, btn = form.querySelector('button')!;
			const base = document.documentElement.dataset.base || '/';
			form.addEventListener('submit', async (e) => {
				e.preventDefault();
				const about = (form.elements.namedItem('about') as HTMLInputElement).value.trim(); if (!about) return;
				if (!hasKey()) { status.textContent = errorText({ code: 'no_key' }); status.className = 'status fit-status error'; return; }
				btn.disabled = true; status.className = 'status fit-status'; status.textContent = 'Reading the posts…';
				try {
					const index = await (await fetch(base + 'llms.txt')).text();
					const res = await ask(`A reader says what they work on. From this blog's index, pick the three posts most useful to them. Return JSON {"picks":[{"title":string,"url":string,"why":string}],"note":string}. URLs copied exactly from the index; "why" one sentence that mentions the reader's situation; "note" one sentence if nothing fits well, else empty.`, { reader: about, index }, { json: true, maxTokens: 400 });
					const picks = (res?.picks || []).slice(0, 3);
					list.innerHTML = picks.map((p: any) => `<li><a href="${p.url}">${p.title}</a><br><span class="meta">${p.why}</span></li>`).join('');
					list.hidden = !picks.length; status.textContent = res?.note || '';
				} catch (err) { status.textContent = errorText(err); status.className = 'status fit-status error'; } finally { btn.disabled = false; }
			});
		}
	}
	customElements.define('reader-fit', ReaderFit);
</script>
