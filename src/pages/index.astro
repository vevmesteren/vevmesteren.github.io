---
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import Timeline from '../components/Timeline.astro';
import FeaturedPost from '../components/FeaturedPost.astro';
import SectionIndex from '../components/SectionIndex.astro';
import BuildsTable from '../components/BuildsTable.astro';
import ReaderFit from '../components/ReaderFit.astro';
import { getEssays, getWorkshop, getRadar, getPosts } from '../lib/posts';

const [essays, workshop, radar, allPosts] = await Promise.all([getEssays(), getWorkshop(), getRadar(), getPosts()]);
const featured = essays[0] || allPosts[0];
const featuredNumber = essays[0] ? essays.length : allPosts.length;

const columns = [
	{ num: '01', title: 'Radar', href: '/radar/', blurb: 'Short, dated, sourced. What moved.', kind: 'radar' as const, items: radar.slice(0, 4) },
	{ num: '02', title: 'Essays', href: '/essays/', blurb: 'Long-form architecture and strategy. Take a coffee.', kind: 'blog' as const, items: essays.slice(0, 4) },
	{ num: '03', title: 'Workshop', href: '/workshop/', blurb: 'Write-ups of the things I build at night.', kind: 'blog' as const, items: workshop.slice(0, 4) },
];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const ogImage = `${base}/og-image/index.png`;
---

<Base landing image={ogImage}>
	<Masthead />
	<Timeline />
	{featured && <FeaturedPost post={featured} number={featuredNumber} />}
	<SectionIndex columns={columns} />
	<BuildsTable />
	<ReaderFit />
</Base>
