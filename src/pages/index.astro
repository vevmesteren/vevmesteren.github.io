---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

// Get the 3 most recent non-draft posts for the homepage
const posts = (await getCollection('blog'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.intro {
				margin-bottom: 3em;
				padding-bottom: 2em;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.intro h1 {
				margin-bottom: 0.5em;
			}
			.intro p {
				font-size: 1.2em;
				color: rgb(var(--gray));
				margin-bottom: 0;
			}
			.recent-posts h2 {
				font-size: 1.25em;
				color: rgb(var(--gray));
				text-transform: uppercase;
				letter-spacing: 0.05em;
				margin-bottom: 1.5em;
			}
			.post-list {
				list-style: none;
				padding: 0;
				margin: 0;
			}
			.post-list li {
				margin-bottom: 2em;
			}
			.post-list a {
				text-decoration: none;
			}
			.post-list .title {
				color: rgb(var(--black));
				font-size: 1.563em;
				line-height: 1.2;
				margin: 0.3em 0;
				transition: color 0.2s ease;
			}
			.post-list a:hover .title {
				color: var(--accent);
			}
			.post-list .date {
				color: rgb(var(--gray));
				font-size: 0.9em;
				margin: 0;
			}
			.post-list .description {
				color: rgb(var(--gray-dark));
				font-size: 1em;
				margin: 0.5em 0 0 0;
			}
			.see-all {
				margin-top: 2em;
				font-size: 1.1em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="intro">
				<h1>Valentin Backofen</h1>
				<p>
					Senior technology leader, software craftsman, and builder. Twenty years in digital
					development — from web agency to social gaming startup to enterprise architecture at
					one of Canada's largest banks. This is where I publish radar findings, project
					announcements, and things I think are worth saying out loud.
				</p>
			</section>

			<section class="recent-posts">
				<h2>Recent posts</h2>
				<ul class="post-list">
					{posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								<p class="date">
									<FormattedDate date={post.data.pubDate} />
								</p>
								<h3 class="title">{post.data.title}</h3>
								<p class="description">{post.data.description}</p>
							</a>
						</li>
					))}
				</ul>
				{posts.length === 0 && (
					<p>No posts yet. Check back soon.</p>
				)}
				{posts.length > 0 && (
					<p class="see-all">
						<a href="/blog/">View all posts &rarr;</a>
					</p>
				)}
			</section>
		</main>
		<Footer />
	</body>
</html>
