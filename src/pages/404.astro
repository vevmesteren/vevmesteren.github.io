---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="Not found" narrow noindex>
	<section class="nf">
		<p class="meta">404</p>
		<h1 class="nf-title">Page not found.</h1>
		<p class="lead">Try the <a href={`${base}/blog/`}>blog</a>, the <a href={`${base}/radar/`}>radar</a>, or press <kbd>Ctrl</kbd> <kbd>/</kbd> to ask the site where something went.</p>
	</section>
</Base>

<style>
	.nf { padding: 96px 0; }
	.nf .meta { margin: 0 0 16px; font: 700 var(--fs-meta)/1 var(--font-mono); color: var(--accent); }
	.nf-title { margin: 0; font-size: var(--fs-feature); font-weight: 800; font-stretch: 72%; letter-spacing: -0.03em; line-height: 0.95; }
	.nf .lead { margin-top: 24px; max-width: 640px; }
	kbd { font-family: var(--font-mono); }
</style>
