---
import Base from '../../layouts/Base.astro';
import { getRadar, formatDate } from '../../lib/posts';
const posts = await getRadar();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="Radar" description="Short, dated, sourced. What moved.">
	<section class="archive-head">
		<h1 class="archive-title">Radar</h1>
		<p class="archive-blurb">Short, dated, sourced. What moved.</p>
	</section>
	<ol class="radar-list">
		{posts.map((p) => (
			<li>
				<a href={`${base}/radar/${p.id}/`}>
					<p class="meta">{formatDate(p.data.date)} · {p.data.domain} · {p.data.sources.length} source{p.data.sources.length === 1 ? '' : 's'}</p>
					<h2 class="title">{p.data.title}</h2>
					<p class="desc">{p.data.description}</p>
				</a>
			</li>
		))}
	</ol>
</Base>

<style>
	.archive-head { padding: 48px 0 32px; border-bottom: var(--rule-heavy); }
	.archive-title { margin: 0; font-size: var(--fs-section); font-weight: 800; font-stretch: 72%; letter-spacing: -0.03em; }
	.archive-blurb { margin: 16px 0 0; font-size: var(--fs-lead); color: var(--ink-3); max-width: 760px; }
	.radar-list { list-style: none; margin: 0; padding: 0; }
	.radar-list li { border-bottom: 1px solid var(--hairline); }
	.radar-list a { display: block; padding: 24px 0; color: var(--ink); }
	.radar-list a:hover .title { color: var(--accent); }
	.radar-list .meta { margin: 0; font: 400 var(--fs-meta)/1.5 var(--font-mono); color: var(--muted); }
	.radar-list .title { margin: 6px 0; font-size: 32px; font-weight: 800; font-stretch: 75%; line-height: 1.1; letter-spacing: -0.02em; }
	.radar-list .desc { margin: 0; font-size: var(--fs-ui); color: var(--ink-3); max-width: 760px; }
</style>
