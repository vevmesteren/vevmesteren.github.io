---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostHeader from '../../components/PostHeader.astro';
import PostLayout from '../../components/PostLayout.astro';
import ExplainSelection from '../../components/ExplainSelection.astro';
import CodeExplain from '../../components/CodeExplain.astro';
import ReadNext from '../../components/ReadNext.astro';
import Quiz from '../../components/Quiz.astro';
import { getPosts, kindOf, readingTime } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post, i) => {
		const sameKind = posts.filter((p) => kindOf(p) === kindOf(post));
		const number = sameKind.length - sameKind.findIndex((p) => p.id === post.id);
		return { params: { slug: post.id }, props: { post, prev: posts[i + 1], next: posts[i - 1], number } };
	});
}
const { post, number } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const ai = post.data.ai;
const path = `${base}/blog/${post.id}/`;
const kind = kindOf(post);
const estReadingTime = readingTime(post.body);
const ogImage = `${base}/og-image/blog/${post.id}.png`;
---

<Base title={post.data.title} description={post.data.description} image={ogImage} type="article" contentKind={kind} contentTags={post.data.tags} contentReadingTime={estReadingTime}>
	<PostHeader post={post} number={number} />
	<PostLayout takeaways={post.data.takeaways}>
		<Content />
	</PostLayout>
	<CodeExplain />
	<ExplainSelection />
	{ai.quiz && <Quiz />}
	{ai.readNext && <ReadNext current={path} />}
</Base>
